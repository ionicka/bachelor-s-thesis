<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashCards.ViewModels"
             x:Class="FlashCards.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F2F5FA">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ TOP NAVBAR ═══════════════════════════════════════ -->
        <Grid Grid.Row="0"
      ColumnDefinitions="*,Auto"
      Padding="16,50,16,12"
      BackgroundColor="#F2F5FA">

            <!-- Avatar + Salut -->
            <HorizontalStackLayout Grid.Column="0" Spacing="10"
                           VerticalOptions="Center">
                <Frame WidthRequest="42" HeightRequest="42"
               CornerRadius="21" Padding="0"
               BorderColor="#F2685C"
               BackgroundColor="#FFFFFF"
               IsClippedToBounds="True">
                    <Label Text="{Binding InitialaUtilizator}"
                   TextColor="#1C2541" FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
                </Frame>
                <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding Salut}" TextColor="#6B7A99" FontSize="12" />
                    <Label Text="{Binding NumeUtilizator}"
                   TextColor="#1C2541" FontSize="15"
                   FontAttributes="Bold" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Iconite dreapta -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8"
                           VerticalOptions="Center">

                <!-- Streak -->
                <Frame BackgroundColor="#EAF0FB"
               BorderColor="#F2A65A"
               CornerRadius="20" Padding="0"
               WidthRequest="72" HeightRequest="36">
                    <HorizontalStackLayout Spacing="4"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                        <Label Text="🔥" FontSize="16" VerticalOptions="Center" />
                        <Label Text="{Binding Streak}"
                       TextColor="#F2A65A" FontSize="15"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <!-- Notificari -->
                <Frame BackgroundColor="#EAF0FB"
               BorderColor="#DCE4F0"
               CornerRadius="20" Padding="0"
               WidthRequest="48" HeightRequest="36">
                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🔔" FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                        <Frame BackgroundColor="#F2685C"
                       CornerRadius="8" Padding="3,1"
                       HorizontalOptions="End" VerticalOptions="Start"
                       IsVisible="{Binding AreNotificari}">
                            <Label Text="{Binding NrNotificari}"
                           TextColor="#1C2541" FontSize="9"
                           FontAttributes="Bold" />
                        </Frame>
                    </Grid>
                </Frame>

                <!-- Admin -->
                <Frame IsVisible="{Binding PoateVedeaAdmin}"
               BackgroundColor="#E8E3FB"
               BorderColor="#7C6FD4"
               CornerRadius="20" Padding="0"
               WidthRequest="48" HeightRequest="36">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeschideAdminPanelCommand}" />
                    </Frame.GestureRecognizers>
                    <Label Text="🛠" FontSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
                </Frame>

                <!-- Deconectare -->
                <Frame BackgroundColor="#EAF0FB"
               BorderColor="#F2685C"
               CornerRadius="20" Padding="0"
               WidthRequest="48" HeightRequest="36">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeconecteazaCommand}" />
                    </Frame.GestureRecognizers>
                    <Label Text="🚪" FontSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
                </Frame>

            </HorizontalStackLayout>

        </Grid>

        <!-- ═══ CONTINUT PRINCIPAL ══════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="20">

                <!-- Carduri de revizuit azi -->
                <Frame BackgroundColor="#FFFFFF" CornerRadius="20"
                       Padding="20" BorderColor="#D9E2F3">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="De revizuit azi"
                                   TextColor="#6B7A99" FontSize="13" />
                            <Label Text="{Binding CarduriAzi, StringFormat='{0} cuvinte'}"
                                   TextColor="#1C2541" FontSize="22"
                                   FontAttributes="Bold" />
                            <Label Text="Cuvinte cu progres programate azi"
                                   TextColor="#9AA8C2" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="📚"
                               FontSize="48" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Sectiunea Lectii (placeholder) -->
                <Label Text="Lectii" TextColor="White"
                       FontSize="20" FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- Vocabular — activ -->
                    <Grid Grid.Column="0">
                        <Frame BackgroundColor="#1A1040"
           BorderColor="#8B7FE8"
           CornerRadius="20" Padding="0"
           HasShadow="False">
                            <VerticalStackLayout Padding="16" Spacing="10">
                                <Label Text="📖" FontSize="32" />
                                <Label Text="Vocabular"
                   TextColor="White" FontSize="16"
                   FontAttributes="Bold" />
                                <Label Text="{Binding CarduriAzi, StringFormat='{0} de invatat'}"
                   TextColor="#7C6FD4" FontSize="12" />
                                <Frame BackgroundColor="#8B7FE8"
                   CornerRadius="12" Padding="8,4"
                   BorderColor="Transparent"
                   HorizontalOptions="Start">
                                    <Label Text="START" TextColor="White"
                       FontSize="11" FontAttributes="Bold" />
                                </Frame>
                            </VerticalStackLayout>
                        </Frame>
                        <Button Command="{Binding MergeVocabularCommand}"
            BackgroundColor="Transparent"
            BorderWidth="0" />
                    </Grid>

                    <!-- Speak — coming soon -->
                    <Frame Grid.Column="1"
                           BackgroundColor="#EEF2F8"
                           BorderColor="#E2E8F2"
                           CornerRadius="20" Padding="16"
                           Opacity="0.5">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="🎙️" FontSize="32" />
                            <Label Text="Speak"
                                   TextColor="#6B7A99" FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="In curand..."
                                   TextColor="#9AA8C2" FontSize="12" />
                            <Frame BackgroundColor="#E2E8F2"
                                   CornerRadius="12" Padding="8,4"
                                   BorderColor="Transparent"
                                   HorizontalOptions="Start">
                                <Label Text="LOCKED" TextColor="#9AA8C2"
                                       FontSize="11" FontAttributes="Bold" />
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Al doilea rand de lectii -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  
                    <Frame Grid.Column="0"
                           BackgroundColor="#EEF2F8"
                           BorderColor="#E2E8F2"
                           CornerRadius="20" Padding="16"
                           Opacity="0.5">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="✍️" FontSize="32" />
                            <Label Text="Lectii"
                                   TextColor="#6B7A99" FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="In curand..."
                                   TextColor="#9AA8C2" FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1"
                           BackgroundColor="#EEF2F8"
                           BorderColor="#E2E8F2"
                           CornerRadius="20" Padding="16"
                           Opacity="0.5">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="🧠" FontSize="32" />
                            <Label Text="Astazi"
                                   TextColor="#6B7A99" FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="In curand..."
                                   TextColor="#9AA8C2" FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Progres saptamana -->
                <Label Text="Aceasta saptamana"
                       TextColor="White" FontSize="20"
                       FontAttributes="Bold" />

                <Frame BackgroundColor="#FFFFFF" CornerRadius="20"
                       Padding="16" BorderColor="#D9E2F3">
                    <CollectionView ItemsSource="{Binding ZileSaptamana}"
                                    HeightRequest="80">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ZiCalendar">
                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center"
                                                     WidthRequest="44">
                                    <Frame WidthRequest="36" HeightRequest="36"
                                           CornerRadius="18" Padding="0"
                                           BackgroundColor="{Binding Culoare}"
                                           BorderColor="Transparent"
                                           HorizontalOptions="Center">
                                        <Label Text="{Binding Eticheta}"
                                               TextColor="#1C2541" FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>
                                    <Label Text="{Binding Eticheta}"
                                           TextColor="#6B7A99" FontSize="11"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <!-- Spatiu jos pentru navbar -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ BOTTOM NAVBAR ════════════════════════════════════ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="#FFFFFF"
              Padding="0,12,0,24">

            <!-- Astazi -->
            <VerticalStackLayout Grid.Column="0" Spacing="4"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="🏠" FontSize="22" HorizontalOptions="Center" />
                <Label Text="Astazi" TextColor="#F2685C" FontSize="11"
                       FontAttributes="Bold" HorizontalOptions="Center" />
                <!-- Punct activ -->
                <BoxView WidthRequest="6" HeightRequest="6"
                         CornerRadius="3" BackgroundColor="#F2685C"
                         HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Lectii -->
            <VerticalStackLayout Grid.Column="1" Spacing="4"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="📝" FontSize="22" HorizontalOptions="Center"
                       Opacity="0.4" />
                <Label Text="Lectii" TextColor="#9AA8C2" FontSize="11"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Vocabular -->
            <VerticalStackLayout Grid.Column="2" Spacing="4"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MergeVocabularCommand}" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="📖" FontSize="22" HorizontalOptions="Center"
                       Opacity="0.4" />
                <Label Text="Vocabular" TextColor="#9AA8C2" FontSize="11"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Speak -->
            <VerticalStackLayout Grid.Column="3" Spacing="4"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="🎙️" FontSize="22" HorizontalOptions="Center"
                       Opacity="0.4" />
                <Label Text="Speak" TextColor="#9AA8C2" FontSize="11"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>

