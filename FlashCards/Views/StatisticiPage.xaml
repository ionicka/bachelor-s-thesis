<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashCards.ViewModels"
             xmlns:conv="clr-namespace:FlashCards.Converters"
             x:Class="FlashCards.Views.StatisticiPage"
             x:DataType="vm:StatisticiViewModel"
             Title="Statistici" BackgroundColor="#F2F5FA">

    <ContentPage.Resources>
        <conv:PercentToDoubleConverter x:Key="PercentToDouble" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Progresul tau" FontSize="24" FontAttributes="Bold"
                   TextColor="White" />

            <ActivityIndicator IsRunning="{Binding SeIncarca}"
                               IsVisible="{Binding SeIncarca}"
                               Color="#F2685C" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="12" RowSpacing="12">

                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF"
                       BorderColor="#D9E2F3" CornerRadius="16" Padding="20">
                    <VerticalStackLayout>
                        <Label Text="{Binding Statistici.CuvinteInvatate}"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="#6FBF73" HorizontalOptions="Center" />
                        <Label Text="Invatate" TextColor="#6B7A99" FontSize="13"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#FFFFFF"
                       BorderColor="#D9E2F3" CornerRadius="16" Padding="20">
                    <VerticalStackLayout>
                        <Label Text="{Binding Statistici.CuvinteConsolidate}"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="#FFD700" HorizontalOptions="Center" />
                        <Label Text="Consolidate" TextColor="#6B7A99" FontSize="13"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#FFFFFF"
                       BorderColor="#D9E2F3" CornerRadius="16" Padding="20">
                    <VerticalStackLayout>
                        <Label Text="{Binding Statistici.CuvinteDeRevizuitAzi}"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="#F2685C" HorizontalOptions="Center" />
                        <Label Text="De revizuit" TextColor="#6B7A99" FontSize="13"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#FFFFFF"
                       BorderColor="#D9E2F3" CornerRadius="16" Padding="20">
                    <VerticalStackLayout>
                        <Label Text="{Binding Statistici.ZileCurenteStreak,
                                      StringFormat='{0} zile'}"
                               FontSize="26" FontAttributes="Bold"
                               TextColor="#F2A65A" HorizontalOptions="Center" />
                        <Label Text="Streak" TextColor="#6B7A99" FontSize="13"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <Frame BackgroundColor="#FFFFFF" BorderColor="#D9E2F3"
                   CornerRadius="16" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Rata de succes" TextColor="#6B7A99" FontSize="14" />
                    <ProgressBar
                        Progress="{Binding Statistici.RataSuccesGlobala,
                                   Converter={StaticResource PercentToDouble}}"
                        ProgressColor="#6FBF73" HeightRequest="12" />
                    <Label Text="{Binding Statistici.RataSuccesGlobala,
                                   StringFormat='{0:F1}%'}"
                           TextColor="#1C2541" FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
